{
  "name": "common-slot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json && node -e \"require('node:fs').cpSync('public','dist/public',{recursive:true})\"",
    "start": "node dist/src/server.js",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "npm run build && playwright test",
    "check": "npm run build && npm test",
    "smoke:live": "tsx scripts/live-smoke.ts"
  },
  "dependencies": {
    "express": "^5.1.0",
    "luxon": "^3.7.2",
    "playwright": "1.62.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/express": "^5.0.3",
    "@types/luxon": "^3.7.1",
    "@types/node": "^22.18.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^4.0.0"
  }
}
